{
  "name": "lwn-js",
  "version": "0.2.0",
  "description": "A high-performance TypeScript UI engine with direct component updates, explicit lifetimes, and server-side rendering.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./html": {
      "types": "./dist/html/index.d.ts",
      "import": "./dist/html/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "main": "index.js",
  "bin": {
    "lwn": "dist/cli.js"
  },
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "happy-dom": "^20.14.5",
    "linkedom": "^0.18.13",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "linkedom": ">=0.18.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "linkedom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "sideEffects": false
}
